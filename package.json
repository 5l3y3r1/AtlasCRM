{
  "name": "warm-ge",
  "version": "1.0.0",
  "description": "warm.ge — Georgia real-estate CRM (Node.js + SQLite production server)",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node --no-warnings server.js",
    "dev": "node --no-warnings --watch server.js",
    "seed": "node --no-warnings seed.js",
    "reset": "node -e \"require('fs').rmSync('warm.db',{force:true});\" && npm run seed"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nanoid": "^3.3.12"
  }
}
