# Hearth — environment configuration
# Copy to .env for local dev; set these as real env vars in production.
# Generate any secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── Required in production ────────────────────────────────────────────────
# Signing key for session JWTs. The server REFUSES TO START in production
# if this is unset — a known key lets anyone mint a session for any account.
JWT_SECRET=

# Marks the deploy as production (enables the JWT_SECRET check).
NODE_ENV=production

# ── Storage ───────────────────────────────────────────────────────────────
# Both MUST point at a mounted persistent volume, or every redeploy wipes
# the database and all uploaded photos/documents. See DEPLOY.md.
DB_PATH=/app/data/warm.db
UPLOADS_DIR=/app/data/uploads

# ── Networking ────────────────────────────────────────────────────────────
# Usually injected by the host (Railway/Render/Fly); 3000 locally.
PORT=3000

# ── Platform administration ───────────────────────────────────────────────
# Comma-separated emails granted platform super-admin (the /admin panel:
# manage every company and its subscription). Keep this list minimal.
SUPER_ADMIN_EMAILS=

# ── Integrations (optional — features degrade gracefully without them) ────
# Shared key the external scraper sends as X-Scraper-Key to POST /api/scraper/ingest.
SCRAPER_KEY=

# Shared key the browser extension sends as X-CRM-Key to POST /api/import/ingest.
CRM_INGEST_KEY=
# Which company extension-imported listings belong to. Defaults to the first
# company in the DB, which is wrong as soon as there is more than one tenant.
CRM_INGEST_COMPANY_ID=

# ── Transactional email ───────────────────────────────────────────────────
# Password resets and email verification. With these unset the app still runs:
# messages are written to the server log instead of being delivered, so you can
# develop without a mail account. Set them before real users sign up, or nobody
# will be able to recover a forgotten password.
# Works with any SMTP provider (Brevo, Resend, Mailgun, Gmail app password...).
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=
MAIL_SMTP_PASS=
MAIL_FROM=Hearth <no-reply@yourdomain.ge>
# Set to 1 only for TLS-on-connect providers (port 465). Port 587 uses STARTTLS.
MAIL_SECURE=

# Public base URL. Used to build the links inside emails — if this is wrong,
# reset links point at the wrong host and silently don't work.
APP_URL=https://your-app.example.com

# ── Backups ───────────────────────────────────────────────────────────────
# Automatic SQLite snapshots. BACKUP_DIR must be on the SAME persistent volume
# as DB_PATH, otherwise the snapshots vanish with the container.
BACKUP_DIR=/app/data/backups
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
# Set to 1 to turn the scheduler off entirely.
BACKUP_DISABLED=

# ── Billing ───────────────────────────────────────────────────────────────
# Free trial length for a newly registered agency.
TRIAL_DAYS=14
# Days of continued access after a subscription lapses, so a slow bank transfer
# doesn't lock a paying customer out.
BILLING_GRACE_DAYS=5
